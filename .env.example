# OpenRouter Configuration
# Required: Your OpenRouter API key from https://openrouter.ai/
# Format: sk-or-v1-<your-key-here>
OPENROUTER_API_KEY=

# Optional: Embedding model to use (default: openai/text-embedding-3-small)
# Supported models: openai/text-embedding-3-small, openai/text-embedding-3-large
EMBEDDING_MODEL=openai/text-embedding-3-small

# Wiki.js Configuration
# Required: Administrator email for Wiki.js
WIKI_ADMIN_EMAIL=admin@wiki.local

# Required: Administrator password for Wiki.js (minimum 8 characters)
WIKI_ADMIN_PASSWORD=ChangeMe123!

# Required: PostgreSQL database password (minimum 8 characters)
POSTGRES_PASSWORD=wikijs123

# MCP Server Configuration
# Optional: Enable write operations (true/false, default: false)
# When enabled, requires WIKI_ADMIN_TOKEN
ENABLE_WRITE_OPERATIONS=false

# Required if ENABLE_WRITE_OPERATIONS=true: Admin JWT token
# Obtain with: eval $(./scripts/deploy-wikijs.sh get-token)
WIKI_ADMIN_TOKEN=

# Sync Pipeline Configuration
# Optional: Polling interval in milliseconds (default: 60000)
SYNC_POLL_INTERVAL_MS=60000

# Optional: Chunk size for large pages (default: 1000 characters)
CHUNK_SIZE=1000

# Optional: Chunk overlap for context preservation (default: 200 characters)
CHUNK_OVERLAP=200

# Database Configuration
# Optional: PostgreSQL host (default: localhost)
POSTGRES_HOST=localhost

# Optional: PostgreSQL port (default: 5432)
POSTGRES_PORT=5432

# Optional: PostgreSQL database name (default: wiki)
POSTGRES_DB=wiki

# Optional: PostgreSQL user (default: wikijs)
POSTGRES_USER=wikijs

# Server Configuration
# Optional: MCP server port (default: 3001)
MCP_PORT=3001

# Optional: Wiki.js port (default: 3000)
WIKI_PORT=3000
